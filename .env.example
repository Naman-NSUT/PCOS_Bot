# ── LLM provider (any OpenAI-compatible endpoint) ───────────────────────────
# OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1   + models like "gpt-4o-mini"
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 + models like "openai/gpt-4o-mini"
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional model overrides (defaults shown).
# NOTE: changing EMBEDDING_MODEL changes the vector dimensionality and requires
#       a full re-ingest: python3 -m src.ingestion.run_ingest --force
# EMBEDDING_MODEL=text-embedding-3-small
# GRADER_MODEL=openai/gpt-4o-mini
# GENERATOR_MODEL=openai/gpt-4o-mini

CHROMA_PERSIST_DIR=./chroma_db

# ── Long-term user memory ───────────────────────────────────────────────────
# REQUIRED in production. Signs user identity tokens; without it a random key is
# generated per boot and every returning user looks new after a restart.
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
APP_SECRET_KEY=
MEMORY_DB_URL=sqlite:///./memory.db
MEMORY_ENABLED=true

# ── LangSmith (optional — enables tracing at https://smith.langchain.com) ────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=pcos-bot
